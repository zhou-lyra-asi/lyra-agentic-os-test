# ─────────────────────────────────────────────────────────────
#  LYRA AGENTIC OS · Adapter configuration (OPTIONAL)
#  Copy to .env.local / .env. Tanpa file ini OS berjalan penuh
#  dalam mode "Local Council" (deterministik, tanpa kunci API).
#  JANGAN pernah commit kunci yang sebenarnya.
# ─────────────────────────────────────────────────────────────

# sim | live | auto   (auto = live hanya bila binary/env tersedia)
VITE_LYRA_MODE=auto
LYRA_MODE=auto

# Kecepatan orkestrasi (ms per langkah). 0 = secepat mungkin.
LYRA_PACE=140

# ── Claude Code · Anthropic ──────────────────────────────────
LYRA_CLAUDE_BIN=claude
# ANTHROPIC_API_KEY=

# ── Antigravity · Google ─────────────────────────────────────
LYRA_ANTIGRAVITY_BIN=ag
# GOOGLE_API_KEY=

# ── Hermes · Nous Research ───────────────────────────────────
LYRA_HERMES_BIN=hermes
# NOUS_API_KEY=

# ── Codex · OpenAI ───────────────────────────────────────────
LYRA_CODEX_BIN=codex
# OPENAI_API_KEY=

# Batas waktu eksekusi adapter nyata (ms)
LYRA_ADAPTER_TIMEOUT=45000
